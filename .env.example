# ------------------------------------------------------------------
# OddsEdge configuration. Copy to ".env" and adjust as needed.
# Every value has a sensible default, so the app runs with no .env at all.
# ------------------------------------------------------------------

# HTTP / WebSocket server port
PORT=3000

# How often (ms) to push a fresh comparison snapshot to the browser
SNAPSHOT_INTERVAL_MS=1000

# ---- Polymarket ----
# gamma -> real public Polymarket API (default).
# demo  -> synthesise an offline book from the slug; no internet needed. Useful
#          to preview the UI or when Polymarket is blocked on your network.
POLYMARKET_PROVIDER=gamma
# If a real Gamma fetch fails, fall back to the demo book instead of erroring.
POLYMARKET_DEMO_ON_ERROR=false
# Public Gamma REST API (event + market metadata)
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# Public CLOB market WebSocket (live level-2 prices)
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Polymarket splits one match across several events (the link you paste is
# usually just the match-winner market; exact score, totals, etc. are separate
# events). When true, the app discovers and merges those sibling events.
POLYMARKET_FETCH_RELATED=true
# Comma-separated slug suffixes appended to the base slug to find sibling events.
# Leave blank to use the built-in list; override once you see the real slugs in
# the logs or at GET /api/debug/polymarket?slug=<slug>.
POLYMARKET_RELATED_SLUGS=
# Safety cap on how many discovery requests to make per match.
POLYMARKET_MAX_RELATED=28

# ---- Norsk Tipping ----
# Norsk Tipping has NO public odds API (their sportsbook runs on Sportradar
# ORAKO). Pick how this app sources their odds:
#
#   mock  -> realistic, self-contained sample odds that jitter live.
#            Default. Lets you run and demo the whole app with zero setup.
#   http  -> call a real JSON endpoint you provide (see src/sources/
#            norsktipping/orako.ts and the README for how to capture it
#            from your browser's DevTools, or plug in Sportradar creds).
NORSKTIPPING_PROVIDER=mock

# Only used when NORSKTIPPING_PROVIDER=http.
# A URL template; {slug}, {home}, {away} are substituted. The response is
# parsed by src/sources/norsktipping/orako.ts (adapt parseOrako() to match).
NORSKTIPPING_HTTP_URL=
# Optional JSON object of extra request headers, e.g. {"x-api-key":"..."}
NORSKTIPPING_HTTP_HEADERS=
# How often (ms) to re-poll Norsk Tipping odds
NORSKTIPPING_POLL_MS=4000

# ---- Polymarket trading (trade.ts) ----
# ONLY needed if you run trade.ts in --live mode. These stay on YOUR machine;
# `.env` is gitignored. Whoever holds PK controls the wallet — keep it secret,
# and prefer a dedicated trading wallet funded with only what you'll stake.
#
# PK: wallet private key that SIGNS your CLOB orders.
PK=0xYOUR_PRIVATE_KEY
# FUNDER: address that actually holds your USDC / positions.
#   email/Magic signup  -> your Polymarket proxy address, SIGNATURE_TYPE=1
#   browser wallet (UI)  -> proxy Safe address,            SIGNATURE_TYPE=2
#   trading from an EOA   -> that EOA address,              SIGNATURE_TYPE=0
FUNDER=0xYOUR_FUNDER_ADDRESS
SIGNATURE_TYPE=1
